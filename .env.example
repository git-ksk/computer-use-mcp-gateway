CUMG_BIND=127.0.0.1:8100
CUMG_MCP_PATH=/mcp
CUMG_BACKEND_COMMAND=cua-driver
CUMG_BACKEND_ARGS=mcp

# Optional comma-separated policy. Deny always wins.
# Empty allowlist exposes all discovered backend tools except explicitly denied tools.
CUMG_ALLOW_TOOLS=
CUMG_DENY_TOOLS=

RUST_LOG=info

# Keep the gateway on localhost and place an authenticated TLS reverse proxy
# such as Cloudflare Tunnel / Access in front of it for remote use.
