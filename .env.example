CUMG_BIND=127.0.0.1:8100
CUMG_MCP_PATH=/mcp
CUMG_BACKEND_COMMAND=cua-driver
CUMG_BACKEND_ARGS=mcp

# Gateway capability policy is deny-by-default.
# This starter set is read-only/non-mutating, but inspection tools can still
# reveal sensitive app/window titles or accessibility text. Review before use.
# Use CUMG_ALLOW_TOOLS=* only when you intentionally want every discovered tool.
CUMG_ALLOW_TOOLS=list_apps,list_windows,get_accessibility_tree,get_screen_size
CUMG_DENY_TOOLS=

# Streamable HTTP Host/Origin guards.
# Empty values keep the derived localhost defaults. For a reverse proxy, add
# the public hostname/origin explicitly instead of disabling validation.
CUMG_ALLOWED_HOSTS=
CUMG_ALLOWED_ORIGINS=

# Local defense-in-depth against an authenticated client building an unbounded
# MCP request queue. Excess MCP HTTP requests fail immediately with HTTP 503.
# Keep reverse-proxy rate limiting as a separate outer control.
CUMG_MAX_HTTP_CONCURRENCY=16

# /healthz returns only coarse readiness by default. Enabling this explicitly
# adds backend PID/CPU/RSS metadata; remote deployments should normally leave it false.
CUMG_HEALTH_DETAILS=false

# Backend resilience. Failed tool calls are never replayed automatically.
CUMG_CONNECT_TIMEOUT_SECS=15
CUMG_TOOL_TIMEOUT_SECS=60
CUMG_RECONNECT_ATTEMPTS=3
CUMG_RECONNECT_BACKOFF_MS=250

# Optional Cua defense-in-depth policy. Cua loads this layer deny-by-default.
# CUA_DRIVER_POLICY_FILE=./examples/cua-policy.yaml

RUST_LOG=info

# Keep the gateway on localhost and place an authenticated TLS reverse proxy
# such as Cloudflare Tunnel / Access in front of it for remote use.
