[Unit]
Description=computer-use-mcp-gateway V2 Hub
After=network-online.target cumg-v2-grant-signer.service
Wants=network-online.target
Requires=cumg-v2-grant-signer.service

[Service]
Type=exec
User=cumg-v2
Group=cumg-v2
EnvironmentFile=-/etc/cumg-v2/hub.env
LoadCredentialEncrypted=hub-secret
LoadCredential=tls-key:/etc/cumg-v2/tls/server.key
Environment=CUMG_V2_HUB_SECRET_FILE=%d/hub-secret
Environment=CUMG_V2_GRANT_SIGNER_SOCKET=/run/cumg-v2-grant-signer/grant-signer.sock
Environment=CUMG_V2_TLS_KEY_PEM_FILE=%d/tls-key
Environment=CUMG_V2_HUB_STATE_DIR=%S/cumg-v2-hub
ExecStart=/usr/local/bin/v2_hub
Restart=on-failure
RestartSec=2s
TimeoutStopSec=45s
StateDirectory=cumg-v2-hub
StateDirectoryMode=0700
RuntimeDirectory=cumg-v2-hub
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
