# Runtime/session quota only. MemoryUsageStore is intentionally non-durable.
CUMG_USAGE_BIND=127.0.0.1:8787
CUMG_USAGE_LIMIT_PER_PRINCIPAL=100
# Install/build mcp-usage-control from source locally; no npm publication is required.
CUMG_MCP_USAGE_CONTROL_MODULE=file:///opt/cumg/mcp-usage-control/packages/core/dist/index.js
CUMG_USAGE_RESERVATION_TTL_MS=60000
CUMG_USAGE_MAX_RETAINED_OPERATIONS=10000
CUMG_USAGE_MAX_RETAINED_BUDGET_KEYS=10000
