CUMG_V2_HUB_ENDPOINT=https://hub.example.com:7443
CUMG_V2_HUB_DOMAIN=hub.example.com
CUMG_V2_DEVICE_ID=REPLACE_WITH_STABLE_DEVICE_ID
CUMG_V2_DEVICE_SECRET_FILE=/home/REPLACE_USER/.config/cumg-v2-agent/secrets/device.key
CUMG_V2_HUB_PUBLIC_KEY_FILE=/home/REPLACE_USER/.config/cumg-v2-agent/trust/hub.pub
CUMG_V2_GRANT_PUBLIC_KEY_FILE=/home/REPLACE_USER/.config/cumg-v2-agent/trust/grant.pub
CUMG_V2_TLS_ROOT_DER_FILE=/home/REPLACE_USER/.config/cumg-v2-agent/trust/tls-root.der
CUMG_V2_STATE_DIR=/home/REPLACE_USER/.local/state/cumg-v2-agent
CUMG_V2_ALLOWED_CWD_ROOTS=/home/REPLACE_USER
# During grant-key overlap only:
# CUMG_V2_ADDITIONAL_GRANT_PUBLIC_KEY_FILES=/home/REPLACE_USER/.config/cumg-v2-agent/trust/grant-next.pub
# During Hub-key rotation only:
# CUMG_V2_HUB_ROTATION_FILE=/home/REPLACE_USER/.config/cumg-v2-agent/trust/hub-rotation.json
# Optional external GUI backend:
# CUMG_V2_CUA_COMMAND=/home/REPLACE_USER/.local/bin/cua-driver
# CUMG_V2_CUA_ARGS=mcp
# CUMG_V2_CUA_BACKEND_VERSION=0.19.3
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
