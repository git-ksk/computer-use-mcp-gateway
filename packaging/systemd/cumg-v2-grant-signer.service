[Unit]
Description=computer-use-mcp-gateway V2 external grant signer
Before=cumg-v2-hub.service

[Service]
Type=exec
User=cumg-v2-signer
Group=cumg-v2
LoadCredentialEncrypted=grant-secret
Environment=CUMG_V2_GRANT_SECRET_FILE=%d/grant-secret
Environment=CUMG_V2_GRANT_SIGNER_SOCKET=/run/cumg-v2-grant-signer/grant-signer.sock
Environment=CUMG_V2_GRANT_SIGNER_POLICY_FILE=/etc/cumg-v2/policy/grant-signer.json
ExecStart=/usr/local/bin/v2_grant_signer
Restart=on-failure
RestartSec=2s
RuntimeDirectory=cumg-v2-grant-signer
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
