# Non-secret configuration only. systemd LoadCredential supplies private keys.
CUMG_V2_HUB_BIND=0.0.0.0:7443
CUMG_V2_DEVICE_PUBLIC_KEY_FILE=/etc/cumg-v2/trust/device.pub
CUMG_V2_TLS_CERT_PEM_FILE=/etc/cumg-v2/tls/server.pem
CUMG_V2_HEARTBEAT_TIMEOUT_SECS=45
CUMG_V2_MAX_AGENT_SESSION_LIFETIME_SECS=3600
CUMG_V2_AGENT_SESSION_REAUTH_DRAIN_SECS=30
CUMG_V2_DRAIN_TIMEOUT_SECS=30
CUMG_V2_CHECKPOINT_GENERATION_ROLLOVER_BYTES=524288
CUMG_V2_MAX_QUEUED_PER_DEVICE=8
CUMG_V2_MAX_AGENT_SESSIONS=2
CUMG_V2_MAX_AGENT_SESSION_STARTS_PER_MINUTE=30
# Optional continuity document during a device-key rotation only:
# CUMG_V2_DEVICE_ROTATION_FILE=/etc/cumg-v2/trust/device-rotation.json

# Keep MCP loopback-only; terminate public HTTPS at the reviewed reverse proxy.
# CUMG_V2_MCP_BIND=127.0.0.1:8081
# CUMG_V2_MCP_RESOURCE=https://hub.example.com/mcp
# CUMG_V2_OAUTH_AUTHORIZATION_SERVER=https://issuer.example.com
# CUMG_V2_OAUTH_INTROSPECTION_ENDPOINT=https://issuer.example.com/oauth2/introspect
# CUMG_V2_OAUTH_INTROSPECTION_CLIENT_ID=cumg-v2-hub
# CUMG_V2_OAUTH_INTROSPECTION_CLIENT_SECRET_FILE=/run/credentials/cumg-v2-hub.service/oauth-introspection-secret
# CUMG_V2_OAUTH_REQUIRED_SCOPES=mcp
# Or, for explicitly single-principal trusted-proxy mode (mutually exclusive with OAuth):
# CUMG_V2_TRUSTED_PROXY_ISSUER=https://access.example.com
# CUMG_V2_TRUSTED_PROXY_SUBJECT=single-principal
# CUMG_V2_TRUSTED_PROXY_SECRET_FILE=/run/credentials/cumg-v2-hub.service/trusted-proxy-secret
# CUMG_V2_TRUSTED_PROXY_MAX_PEER_CONCURRENCY=4
# CUMG_V2_TRUSTED_PROXY_MAX_PEER_REQUESTS_PER_MINUTE=60
# CUMG_V2_NORTHBOUND_POLICY_FILE=/etc/cumg-v2/policy/northbound.json
# CUMG_V2_MAX_NORTHBOUND_CONCURRENCY=16
# CUMG_V2_MAX_NORTHBOUND_REQUESTS_PER_MINUTE=120
# Optional local MemoryUsageStore accounting sidecar:
# CUMG_V2_USAGE_ENDPOINT=http://127.0.0.1:8787/
# CUMG_V2_USAGE_TIMEOUT_SECS=2

# Standard OTLP only; no CUMG-specific telemetry credential format.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
