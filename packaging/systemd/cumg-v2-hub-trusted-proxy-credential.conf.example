# Required systemd drop-in when trusted-proxy fixed-principal mode is enabled.
# Provision the same random secret independently to the reviewed local proxy and
# configure it to overwrite X-CUMG-Trusted-Proxy-Token before loopback forwarding.
[Service]
LoadCredentialEncrypted=trusted-proxy-secret
Environment=CUMG_V2_TRUSTED_PROXY_SECRET_FILE=%d/trusted-proxy-secret
